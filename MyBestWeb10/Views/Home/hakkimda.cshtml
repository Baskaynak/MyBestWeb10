@{
    ViewData["Title"] = "Hakkimda";
}

<h1>Su'nun Yeni Sayfasi</h1>
<p>Bu sayfa yeni bir branch uzerinden, yeni bir dosya olarak eklendi!</p>

<h1>Hakkimda</h1>
<p>Su an saat: @DateTime.Now</p>

<div style="text-align: center; margin-top: 30px;">
    <div class="css-nazar-boncugu-hakkimda orta-boncuk">
        <div class="acik-mavi-h">
            <div class="beyaz-h">
                <div class="siyah-h"></div>
            </div>
        </div>
    </div>
    <p style="font-size: 16px; margin-top: 15px; font-weight: bold;">Masallah!</p>
</div>

<style>
    .css-nazar-boncugu-hakkimda {
        width: 80px;
        height: 80px;
        background-color: #002fa7;
        border-radius: 50%;
        display: inline-block;
        position: relative;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
    }

    .acik-mavi-h {
        width: 54px;
        height: 54px;
        background-color: #87ceeb;
        border-radius: 50%;
        position: absolute;
        top: 13px;
        left: 13px;
    }

    .beyaz-h {
        width: 30px;
        height: 30px;
        background-color: #ffffff;
        border-radius: 50%;
        position: absolute;
        top: 12px;
        left: 12px;
    }

    .siyah-h {
        width: 14px;
        height: 14px;
        background-color: #000000;
        border-radius: 50%;
        position: absolute;
        top: 8px;
        left: 8px;
    }
</style>