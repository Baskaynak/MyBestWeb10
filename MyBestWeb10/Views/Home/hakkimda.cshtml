@{
    ViewData["Title"] = "Hakkimda";
}

<h1>Su'nun Yeni Sayfasi</h1>
<p>Bu sayfa yeni bir branch uzerinden, yeni bir dosya olarak eklendi!</p>

<h1>Hakkimda</h1>
<p>Su an saat: @DateTime.Now</p>

<div style="text-align: center; margin-top: 20px;">
    <div class="nazar-kutusu">
        <span class="nazar-boncugu-buyuk">🧿</span>
    </div>
    <p style="font-size: 16px; margin-top: 10px;">Masallah!</p>
</div>

<style>
    /* Dış kutuyu bir grafik alanı haline getiriyoruz */
    .nazar-kutusu {
        display: inline-block;
        perspective: 1000px;
        transform-style: preserve-3d;
    }

    .nazar-boncugu-buyuk {
        display: block !important; /* inline-block yerine block yaparak harf kimliğinden çıkardık */
        font-size: 80px;
        line-height: 1;
        animation: parlaDonHakkimda 3s infinite linear !important; /* ease-in-out yerine daha akıcı linear yaptık */
        transform-origin: center center;
    }

    @@keyframes parlaDonHakkimda {
        0% { 
            transform: rotate(0deg) scale(1); 
            filter: drop-shadow(0 0 5px rgba(0, 0, 255, 0.5)); 
        }
        50% { 
            transform: rotate(180deg) scale(1.1); 
            filter: drop-shadow(0 0 25px rgba(0, 255, 255, 0.8)); 
        }
        100% { 
            transform: rotate(360deg) scale(1); 
            filter: drop-shadow(0 0 5px rgba(0, 0, 255, 0.5)); 
        }
    }
</style>