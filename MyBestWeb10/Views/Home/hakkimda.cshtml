@{
    ViewData["Title"] = "Hakkimda";
}

<h1>Su'nun Yeni Sayfasi</h1>
<p>Bu sayfa yeni bir branch uzerinden, yeni bir dosya olarak eklendi!</p>

<h1>Hakkimda</h1>
<p>Su an saat: @DateTime.Now</p>

<div style="text-align: center; margin-top: 30px;">
    <div class="css-nazar-boncugu-v2">
        <div class="acik-mavi-v2">
            <div class="beyaz-v2">
                <div class="siyah-v2"></div>
            </div>
        </div>
    </div>
    <p style="font-size: 16px; margin-top: 15px; font-weight: bold;">Masallah!</p>
</div>

<style>
    /* Katman katman kusursuz bir nazar boncuğu çiziyoruz */
    .css-nazar-boncugu-v2 {
        width: 80px;
        height: 80px;
        background-color: #002fa7; /* Koyu lacivert dış çeper */
        border-radius: 50%;
        display: inline-block;
        position: relative;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
        animation: firilFirilDonYeni 4s infinite linear !important; /* Dönüş animasyonu */
    }

    .acik-mavi-v2 {
        width: 54px;
        height: 54px;
        background-color: #87ceeb;
        border-radius: 50%;
        position: absolute;
        top: 13px;
        left: 13px;
    }

    .beyaz-v2 {
        width: 30px;
        height: 30px;
        background-color: #ffffff;
        border-radius: 50%;
        position: absolute;
        top: 12px;
        left: 12px;
    }

    .siyah-v2 {
        width: 14px;
        height: 14px;
        background-color: #000000;
        border-radius: 50%;
        position: absolute;
        top: 8px;
        left: 8px;
    }

    /* .NET derleyicisinin takılmaması için çift @@ işareti garantili kuralı */
    @@keyframes firilFirilDonYeni {
        0% {
            transform: rotate(0deg);
            filter: drop-shadow(0 0 2px rgba(0, 0, 255, 0.4));
        }
        50% {
            filter: drop-shadow(0 0 15px rgba(0, 255, 255, 0.7));
        }
        100% {
            transform: rotate(360deg);
            filter: drop-shadow(0 0 2px rgba(0, 0, 255, 0.4));
        }
    }
</style>